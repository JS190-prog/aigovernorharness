# Dependencies
node_modules/

# Build output (generated by `tsc`)
build/

# Logs
*.log
mcp-shell.log

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Runtime / harness state (written at runtime, not source)
*.lock
tmp/
runtime/state/*.jsonl*
runtime/state/*.json
runtime/state/migration-manifest.json
runtime/state/migrated_sources/

# Python bytecode cache (e.g. from running the pack_audit fixture)
__pycache__/
*.pyc

# Locally generated incident corpora may contain private trace context.
testdata/incidents/*.local.json
testdata/incidents/*.private.json

# Deployment-specific evidence-hint supplement may contain local paths.
# Ship only the .example.json; keep the live file local.
config/evidence_hints.supplement.json
